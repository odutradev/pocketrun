# Copie para api/.env no desenvolvimento local.
# A API lê api/.env e depois o .env da raiz; o primeiro valor encontrado vale.
# Todas as variáveis são obrigatórias: sem uma delas, ou com valor inválido, a API não inicia.

# Uma porta só: rotas públicas na raiz e rotas do painel sob /admin
PORT=5000

# URL pública dos links curtos e das páginas. A API recusa destinos de link que apontem para ela
# e só entrega páginas nesse domínio
LINKS_URL=http://localhost:5000
# Interface de escuta. 127.0.0.1 deixa a API só na sua máquina e evita o pedido do firewall do Windows; 0.0.0.0 escuta em todas
HOST=127.0.0.1

CORS_ALLOWED_ORIGINS=*
# O painel entra com cookie de sessão: use a origem exata do painel, nunca *
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Aceita o login do painel em HTTP (true ou false). Com false, o cookie de sessão só vai por HTTPS.
# O navegador trata http://localhost como seguro, então false funciona no desenvolvimento local
ALLOW_HTTP=false

MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=pocketrun_dev

# Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
JWT_SECRET=

# Chave dos PINs das páginas protegidas (hash dos PINs, sessões e limite de tentativas)
# Gere com: openssl rand -hex 32, diferente do JWT_SECRET. Trocar depois invalida todos os PINs já criados
PAGE_ACCESS_SECRET=
