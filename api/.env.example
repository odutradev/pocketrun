PORT=8080
ENV=development
CORS_ALLOWED_ORIGINS=*

# ==============================================================================
# OPÇÕES DE CONEXÃO COM O MONGODB
# ==============================================================================

# --- Opção 1: MongoDB Local (Container Docker ou instalação local) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=pocketrun

# --- Opção 2: MongoDB Remoto / Nuvem (ex: MongoDB Atlas) ---
# Descomente a linha abaixo e insira suas credenciais do Atlas/Remoto:
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.mongodb.net/?retryWrites=true&w=majority
# MONGODB_NAME=pocketrun
