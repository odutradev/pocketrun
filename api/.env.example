# Copie para api/.env no desenvolvimento local.
# A API lê api/.env e depois o .env da raiz; o primeiro valor encontrado vale.

# Uma porta só: rotas públicas na raiz e rotas do painel sob /admin
PORT=5000

# URL pública dos links curtos e das páginas. A API recusa destinos de link que apontem para ela
# e, com valor, só entrega páginas nesse domínio
LINKS_URL=http://localhost:5000
# Interface de escuta. 127.0.0.1 deixa a API só na sua máquina e evita o pedido do firewall do Windows; vazio escuta em todas
HOST=127.0.0.1

CORS_ALLOWED_ORIGINS=*
# O painel entra com cookie de sessão: use a origem exata do painel, nunca *
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=pocketrun_dev

JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# Chave dos PINs das páginas protegidas (hash dos PINs, sessões e limite de tentativas)
# Use uma chave longa e aleatória, diferente do JWT_SECRET. Trocar depois invalida todos os PINs já criados
PAGE_ACCESS_SECRET=troque_por_outra_chave_longa_e_aleatoria
