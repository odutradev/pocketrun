# Copie para api/.env no desenvolvimento local.
# A API lê api/.env e depois o .env da raiz; o primeiro valor encontrado vale.

# "all" sobe a API pública e a admin juntas, cada uma na sua porta
API_MODE=all
PORT=5000
ADMIN_PORT=5001

CORS_ALLOWED_ORIGINS=*
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=pocketrun_dev

JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
