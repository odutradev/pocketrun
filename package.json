{
  "name": "pocketrun",
  "version": "1.1.7",
  "description": "Monorepo da aplicação PocketRun contendo a API backend em Go, a UI frontend em React/Vite, esteira CI/CD via GitHub Actions e configurações para deploy.",
  "homepage": "https://github.com/odutradev/pocketrun#readme",
  "bugs": {
    "url": "https://github.com/odutradev/pocketrun/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odutradev/pocketrun.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"api,ui\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "cd api && go run cmd/server/main.go",
    "dev:ui": "npm run dev --prefix ui",
    "publish": "npx pub --bump-package --push"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
