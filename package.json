{
  "name": "pocketrun",
  "version": "1.7.9",
  "private": true,
  "description": "Monorepo da aplicação PocketRun contendo a API backend em Go, a UI frontend em React/Vite, esteira CI/CD via GitHub Actions e configurações para deploy.",
  "homepage": "https://github.com/odutradev/pocketrun#readme",
  "bugs": {
    "url": "https://github.com/odutradev/pocketrun/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odutradev/pocketrun.git"
  },
  "license": "ISC",
  "scripts": {
    "dev": "concurrently -n \"api,web\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd api && go run ./cmd/api",
    "dev:web": "npm --prefix ui run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd api && go build -o bin/api ./cmd/api",
    "build:web": "npm run sync:llms && npm --prefix ui run build",
    "sync:llms": "node -e \"require('fs').copyFileSync('llms.txt', 'ui/public/llms.txt')\"",
    "lint": "npm --prefix ui run lint",
    "test": "npm run test:api",
    "test:api": "cd api && go test ./...",
    "reset": "cd api && go run ./cmd/reset",
    "reset:admin": "cd api && go run ./cmd/reset --admin"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
