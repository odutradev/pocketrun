# Portas publicadas no host (no dev local, sao as portas em que cada servidor escuta)
PORT=5000
ADMIN_PORT=5001
FRONTEND_PORT=3000

# Modo da API: all, public ou admin
API_MODE=all

# URL da API admin consumida pelo painel (publica, embutida no build)
VITE_API_URL=http://localhost:5001

# CORS
CORS_ALLOWED_ORIGINS=*
ADMIN_CORS_ALLOWED_ORIGINS=*

# Banco de dados MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=pocketrun

# Autenticacao
JWT_SECRET=troque_por_uma_chave_secreta_forte
