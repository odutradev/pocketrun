# URL pública da API. O painel lê ao iniciar o container (o painel usa as rotas sob /admin)
API_URL=http://localhost:5000

# URL pública dos links curtos e das páginas (QR code, cópia, prévias)
# As páginas só abrem nesse domínio, para o HTML delas nunca rodar no domínio da API
LINKS_URL=http://localhost:5000

# CORS: rotas públicas e rotas do painel (/admin)
CORS_ALLOWED_ORIGINS=*
# O painel entra com cookie de sessão: use a origem exata do painel, nunca *
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Aceita o login do painel em HTTP (true ou false). Com false, o cookie de sessão só vai por HTTPS.
# Use true só quando o domínio ainda não tem HTTPS, como os *.traefik.me do Dokploy: em HTTP a sessão pode ser copiada na rede
ALLOW_HTTP=false

# Banco de dados MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=pocketrun

# Todas as variáveis são obrigatórias: sem uma delas, ou com valor inválido, a API e o painel não iniciam

# Autenticação. Gere com: openssl rand -hex 32 (mínimo de 32 caracteres)
JWT_SECRET=

# Chave dos PINs das páginas protegidas (hash dos PINs, sessões e limite de tentativas)
# Gere com: openssl rand -hex 32, diferente do JWT_SECRET. Trocar depois invalida todos os PINs já criados
PAGE_ACCESS_SECRET=
