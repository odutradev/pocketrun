# Portas publicadas no host pelo docker-compose.override.yml (dev local)
PORT=5000
FRONTEND_PORT=3000

# URL da API, embutida no build do painel (o painel usa as rotas sob /admin)
VITE_API_URL=http://localhost:5000

# URL pública dos links curtos e das páginas (QR code, cópia, prévias). Vazio usa a URL da API
# Com valor, as páginas só abrem nesse domínio, para o HTML delas nunca rodar no domínio da API
LINKS_URL=http://localhost:5000

# CORS: rotas públicas e rotas do painel (/admin)
CORS_ALLOWED_ORIGINS=*
# O painel entra com cookie de sessão: use a origem exata do painel, nunca *
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Banco de dados MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=pocketrun

# Autenticacao
JWT_SECRET=troque_por_uma_chave_secreta_forte

# Chave dos PINs das páginas protegidas (hash dos PINs, sessões e limite de tentativas)
# Use uma chave longa e aleatória, diferente do JWT_SECRET. Trocar depois invalida todos os PINs já criados
PAGE_ACCESS_SECRET=troque_por_outra_chave_longa_e_aleatoria
