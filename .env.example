# Configurações de Portas no Host
PORT=5002
ADMIN_PORT=5003
UI_PORT=3001
ENV=production
API_MODE=all

# URLs e CORS
VITE_API_URL=https://admin.pocketrun.odutra.com
VITE_ADMIN_API_URL=https://admin.pocketrun.odutra.com
CORS_ALLOWED_ORIGINS=*
ADMIN_CORS_ALLOWED_ORIGINS=*

# Banco de Dados MongoDB
MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_NAME=pocketrun

# Autenticação
JWT_SECRET=sua_chave_secreta_jwt_aqui
