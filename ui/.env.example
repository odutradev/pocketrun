# Copie para ui/.env no desenvolvimento local. As duas são obrigatórias: sem elas o npm run dev não inicia.

# URL da API. O painel usa as rotas sob /admin e a aba Snippets mostra a raiz.
VITE_API_URL=http://localhost:5000

# URL pública dos links curtos e das páginas (QR code, cópia, prévias)
VITE_LINKS_URL=http://localhost:5000
