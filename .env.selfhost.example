# Self-host com as imagens do Docker Hub e o MongoDB no mesmo compose
# Copie para .env ao lado do docker-compose.yml do README ("docker-compose.yml com MongoDB local")
# Todas as variáveis são obrigatórias: sem uma delas, ou com valor inválido, a API e o painel não iniciam

# URL pública da API. O painel lê ao iniciar o container
API_URL=https://api.pocketrun.com

# URL pública dos links curtos e das páginas. As páginas só abrem nesse domínio
LINKS_URL=https://link.pocketrun.com

# CORS: rotas públicas e rotas do painel (/admin)
CORS_ALLOWED_ORIGINS=*
# Origem exata do painel, nunca *: o painel entra com cookie de sessão
ADMIN_CORS_ALLOWED_ORIGINS=https://pocketrun.com

# MongoDB do serviço "mongo" do compose, alcançado pelo nome na rede interna
MONGODB_URI=mongodb://mongo:27017
MONGODB_NAME=pocketrun

# Gere cada segredo com: openssl rand -hex 32 (mínimo de 32 caracteres, um diferente do outro)
JWT_SECRET=
# Trocar depois invalida todos os PINs já criados
PAGE_ACCESS_SECRET=
